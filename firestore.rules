rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // حساب مؤكَّد ببريد جامعة الموصل الرسمي فقط
    function ok() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@uomosul[.]edu[.]iq');
    }
    function me() { return request.auth.token.email.lower(); }
    // معرّف الإرسال والتقييم = رقم صاحب الاستمارة _ رقم الاستمارة
    function mine(id) { return id.matches(request.auth.uid + '_.*'); }
    function subPath(id) { return /databases/$(database)/documents/subs/$(id); }
    // جهات التقييم: المسؤول المباشر (sup) ورئيس اللجنة العلمية (com)
    function ev(id) { return exists(subPath(id)) && get(subPath(id)).data.sup == me(); }
    // جهات المصادقة: رئيس القسم (hod) والعميد (dean)
    function isSup(u, f) {
      return ev(u + '_' + f + '_sup') || ev(u + '_' + f + '_com')
          || ev(u + '_' + f + '_hod') || ev(u + '_' + f + '_dean');
    }
    function rv(id) { return /databases/$(database)/documents/reviews/$(id); }
    // ترتيب المراحل: رئيس القسم بعد التقييمين، والعميد بعد رئيس القسم
    function prereq(id) {
      let p = id.split('_');
      let b = p[0] + '_' + p[1];
      return (p[2] != 'hod' && p[2] != 'dean')
          || (p[2] == 'hod' && exists(rv(b + '_sup')) && exists(rv(b + '_com')))
          || (p[2] == 'dean' && exists(rv(b + '_hod')));
    }

    // استمارات التدريسي ووثائقها: يراها صاحبها، والمسؤول الذي أُرسلت إليه
    match /users/{u}/forms/{f} {
      allow read: if ok() && (request.auth.uid == u || isSup(u, f));
      allow write: if ok() && request.auth.uid == u;
      match /f/{c} {
        allow read: if ok() && (request.auth.uid == u || isSup(u, f));
        allow write: if ok() && request.auth.uid == u;
      }
    }

    // الإرسال التلقائي إلى جهات التقييم
    match /subs/{id} {
      allow read: if ok() && (mine(id) || resource.data.sup == me());
      allow create, update: if ok() && mine(id)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sup is string
        && request.resource.data.sup.matches('.*@uomosul[.]edu[.]iq')
        && request.resource.data.sup != me();
      allow delete: if ok() && mine(id);
    }

    // التقييم والمصادقة: تكتبه كل جهة لنفسها، ويقرؤه التدريسي وبقية جهات السلسلة
    match /reviews/{id} {
      allow read: if ok() && (mine(id) || isSup(id.split('_')[0], id.split('_')[1]));
      allow write: if ok() && !mine(id) && ev(id) && prereq(id);
    }

    // أي مسار آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
